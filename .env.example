# Copiá este archivo como .env y completá las claves localmente.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ESP32_PORT=/dev/ttyUSB0
ESP32_BAUDRATE=115200
# Usar "0" para cámara V4L2 o pegar un pipeline GStreamer para la IMX219 CSI.
CAMERA_SOURCE=0
WAKE_WORD=alexa
WHISPER_MODEL=tiny
